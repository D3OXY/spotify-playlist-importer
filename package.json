{
  "name": "spotify-playlist-importer",
  "version": "1.0.0",
  "description": "Complete public Spotify playlist imports using isolated, unauthenticated Chromium sessions",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@12.15.0",
  "main": "./dist/importer.js",
  "types": "./dist/importer.d.ts",
  "exports": {
    ".": { "types": "./dist/importer.d.ts", "import": "./dist/importer.js" }
  },
  "bin": { "spotify-playlist-importer": "./dist/cli.js" },
  "files": ["dist", "README.md", "examples"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "extract": "node dist/cli.js",
    "prepare": "pnpm run build"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
